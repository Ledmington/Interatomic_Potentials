units        lj
atom_style   ellipsoid
dimension    2

lattice      sq 0.02
region       box block 0 40 0 40 -0.5 0.5
create_box   2 box
create_atoms 1 box

set          group all type/fraction 2 0.99999 95392

set          type 1 mass 1.0
set          type 2 mass 1.5

set          type 1 shape 1 1 1
set          type 2 shape 3 1 1

set          group all quat/random 18238

velocity     all create 2.4 87287 mom yes rot yes dist gaussian

compute      rot all temp/asphere

pair_style   gayberne 1.0 3.0 1.0 4.0
pair_coeff   1 1 3.0 1.0 1 1 1 1 1 1 2.5
pair_coeff   1 2 3.0 1.0 1 1 1 0 0 0
pair_coeff   2 2 1.0 1.0 1 1 0.2 0 0 0

neighbor     0.8 bin
fix          2 all enforce2d

thermo_style custom step temp c_rot epair etotal press vol
thermo       100

timestep     0.002

compute      q all property/atom quatw quati quatk quatj shapex shapey shapez

dump         1 all custom 100 dump.ellipse.gayberne id type x y z c_q[1] c_q[2] c_q[3] c_q[4]

# -------------------------
# STAGED COOLING SCHEDULE
# -------------------------

fix          1 all nvt/asphere temp 2.4 2.4 0.1
run          5000

unfix        1

fix          1 all nvt/asphere temp 2.4 1.5 0.1
run          5000

unfix        1

fix          1 all nvt/asphere temp 1.5 0.8 0.1
run          5000

unfix        1

fix          1 all nvt/asphere temp 0.8 0.2 0.1
run          10000

unfix        1

# final production (no thermostat)
fix          3 all nve/asphere
run          20000
