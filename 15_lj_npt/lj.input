units      lj
dimension  2
atom_style sphere
boundary   p p p

region       myregion block 0 100 0 100 -1 1
create_box   1 myregion
create_atoms 1 random 2000 123456 myregion overlap 1.0

pair_style lj/cut 4.0
pair_coeff * *  1.0 1.0

dump mydump all custom 100 lj.lammpstraj id type x y z radius

thermo       100
thermo_style custom step temp press vol pe ke etotal

minimize 1e-6 1e-8 1000 10000

timestep 0.001

fix mynpt all npt temp 1.0 0.01 $(100.0*dt) iso 1.0 1.0 $(1000.0*dt)
run 100000
unfix mynpt
