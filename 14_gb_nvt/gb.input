units      lj
atom_style ellipsoid
dimension  2
boundary   p p p

region       myregion block 0 100 0 100 -1 1
create_box   1 myregion
create_atoms 1 random 2000 123456 myregion overlap 3.0
set          type 1 shape 3.0 1 1
set          group all quat/random 123456

pair_style gayberne 1.0 1.0 2.0 4.0
pair_coeff * *   3.0 1.0   5.0 5.0 1.0   5.0 5.0 1.0

thermo 100
thermo_style custom step temp pe ke etotal

compute     mycompute all property/atom quatw quati quatj quatk shapex shapey shapez
dump        mydump all custom 100 gb.lammpstraj id type x y z c_mycompute[*]
dump_modify mydump &
            colname c_mycompute[1] quatw &
            colname c_mycompute[2] quati &
            colname c_mycompute[3] quatj &
            colname c_mycompute[4] quatk &
            colname c_mycompute[5] shapex &
            colname c_mycompute[6] shapey &
            colname c_mycompute[7] shapez

minimize 1e-6 1e-8 1000 10000

timestep 0.001

fix mynvt all nvt/asphere temp 1.0 0.01 $(100.0*dt)
run 100000
unfix mynvt

fix mynvt all nvt/asphere temp 0.01 0.01 $(100.0*dt)
run 100000
unfix mynvt
